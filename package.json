{
  "name": "crew-change-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crew Change Tracker for Success Marine Service Co., Ltd.",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --test-scheduled",
    "db:local": "wrangler d1 migrations apply cct --local",
    "db:remote": "wrangler d1 migrations apply cct --remote",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "node tests/e2e/e2e-ui.mjs",
    "test:e2e:audit": "node tests/e2e/audit-app.mjs",
    "test:e2e:offline": "node tests/e2e/offline.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.130.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
